# Prediction Market Terminal
# This app is research/paper-only by default. It does not place live orders.

# --- Public deployment (docker compose + deploy/Caddyfile) -------------------
# Apex hostname of the site, without scheme. Caddy serves the control room at
# https://$DOMAIN and the Streamlit terminal at https://app.$DOMAIN, so both
# names need DNS records pointing at the server. Compose refuses to start
# Caddy while this is empty. Not needed for local development.
DOMAIN=

# Control-room API (api/server.py). All optional; defaults suit local dev.
# Bind address/port for `python api/server.py` (compose passes 0.0.0.0:8787).
API_HOST=
API_PORT=
# Extra browser origins allowed to call the API cross-origin, comma-separated.
# The frontend is served same-origin and needs none; the default is the two
# local addresses (http://127.0.0.1:8787, http://localhost:8787).
CORS_ORIGINS=
# Per-visitor rate limits: the two expensive routes (/api/backtest, /api/risk)
# get RATE_LIMIT_PER_MIN with a burst of RATE_LIMIT_BURST; everything under
# /api/ shares RATE_LIMIT_GLOBAL_PER_MIN. Defaults 6 / 3 / 120. 0 disables.
RATE_LIMIT_PER_MIN=
RATE_LIMIT_BURST=
RATE_LIMIT_GLOBAL_PER_MIN=
# Header carrying the visitor address behind the proxy. Default X-Forwarded-For
# is right for Caddy on the edge; behind Cloudflare set CF-Connecting-IP,
# otherwise every visitor shares Cloudflare's edge address and its bucket.
RATE_LIMIT_IP_HEADER=
# Flag log of the risk screen (app/risk_log.py): every event the screen flags
# is appended to <RISK_LOG_DIR>/flags.jsonl with side, price and wallets at
# that moment, for review afterwards (/api/risk/log). Default data/risk_flags
# under the repo root. On Railway the filesystem is ephemeral — mount a volume
# at /app/data (or point RISK_LOG_DIR into one) or the log vanishes on deploy.
# A read-only directory only prints a warning; the screen keeps working.
RISK_LOG_DIR=
# Minimum score for a row to be logged (default 40 = the "Elevated" band).
RISK_LOG_MIN_SCORE=
# > 0 runs the risk computation every N minutes in a background thread and
# logs the flags even when nobody opens the page (default 0 = off; the
# computation itself is cached 300 s, so 5 is the useful minimum).
RISK_LOG_INTERVAL_MIN=

# Persistent whale-tape store (src/trade_store.py). The co-trading network on
# the risk screen sees ~one day of live tape; the store extends it to weeks so
# the strict edge rules get a real chance. Filled by scripts/run_trade_ingest.py
# (loop, stop file data/trade_ingest.stop). Without the file nothing changes.
# Path of the SQLite file. Default data/trade_store.sqlite; on Railway point it
# into the mounted volume or it vanishes on deploy.
TRADE_STORE_PATH=
# How many days of stored tape the network reads (default 14).
TRADE_STORE_WINDOW_DAYS=
# 1 = the API process also records the live pages it fetches anyway. Default
# off: with a separate ingest runner exactly one process writes the store.
TRADE_STORE_RECORD=

# Paper copy desk (the Copy trade page of the control room, /api/copy/*).
# Writes — follow/pause a trader, settings, top-ups, a sync pass — are accepted
# from this machine only (loopback, no proxy header) while this is empty. Set
# a long random token to allow writes from elsewhere; the page then asks for
# it once and sends it as X-Admin-Token. Reads never need it.
COPY_ADMIN_TOKEN=
# Where the desk's books live (copy_trading.sqlite, copy_settings.json, the
# daemon status file). Default data/ under the repo. On a PaaS with an
# ephemeral filesystem point it into the mounted volume (Railway: /data/...),
# or every deploy forgets the traders.
COPY_DATA_DIR=
# 1 = run the copy daemon inside the API process (one service, one volume —
# how the live host does it). Locally leave it off and run
# scripts/run_copy_trader.py (or scripts\start_paper_desk.ps1) instead.
COPY_DAEMON=
# 1 = reads of /api/copy need the admin token too (a private desk). Default:
# readable by everyone, writable by the token holder.
COPY_DESK_PRIVATE=

# Paper Copy-Trading Defaults
COPY_TARGET_WALLET=0x204f72f35326db932158cba6adff0b9a1da95e14
PAPER_START_CASH=1000
COPY_SCALE=0.01
MAX_ORDER_EQUITY_PCT=0.05
LIVE_TRADING_ENABLED=false

# Fast public-chain polling for the paper copy runner.
POLYGON_RPC_URL=https://polygon-pokt.nodies.app
FAST_CHAIN_POLL_INTERVAL=1
PUBLIC_API_FALLBACK_INTERVAL=30
SETTLEMENT_SYNC_INTERVAL=180

# Reserved for a later real-order mode; unused while LIVE_TRADING_ENABLED=false.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_FUNDER_ADDRESS=

# Kalshi API, market data only.
#
# Create the key with the READ scope. A key created without an explicit scope
# gets full trading rights, and this repo never needs them: app/kalshi_auth.py
# refuses anything but GET and blocks order paths outright.
#
# Creating a key returns two things: a Key ID, and an RSA private key in PEM
# format that is shown exactly once. Put the PEM file OUTSIDE this repository -
# it is public and gets attached to job applications, and a gitignore rule only
# protects against accident, not against `git add -f` or a zip of the folder.
# Suggested location on Windows: %USERPROFILE%\.kalshi\kalshi_private_key.pem
# Only the PATH goes here, never the key itself.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Block-explorer key for the on-chain wallet ledger scans
# (scripts/scan_token_ledger.py, scan_erc1155_ledger.py,
# scan_wallet_ledger_parallel.py) and for the wallet flows route
# (GET /api/wallet/{wallet}/flows via app/flow_fetch.py; without a key the
# route answers 503). Read-only: these only ever GET transfer lists. A free
# key is enough; the parallel scanner rate-limits itself.
ETHERSCAN_API_KEY=

# Telegram alert delivery (BotFather token + target chat id). Env values override
# data/app_settings.json and are never written back to disk. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin allowlist for the Settings page when Google sign-in is enabled via
# .streamlit/secrets.toml [auth] (see .streamlit/secrets.toml.example).
# Comma-separated; overrides [admin].emails in secrets.toml. Leave empty to keep
# the allowlist in secrets.toml. Without [auth] secrets this has no effect.
ADMIN_EMAILS=
